# Copiar para .env e opcional; os valores abaixo ja sao os defaults.
# Docker Compose carrega .env quando presente. Para execucao Python no host,
# exporte as variaveis no shell ou use o mecanismo do seu ambiente.
# Nenhuma credencial e necessaria: o Elasticsearch e somente local e sem TLS.
LOG_LEVEL=INFO
CNEFE_INPUT_PATH=29_BA.csv
SEARCH_INPUT_PATH=2026_teste_tecnico_relinke_cidacs(in).csv
CNEFE_PARQUET_PATH=data/processed/cnefe_bahia.parquet
CNEFE_NORMALIZED_PARQUET_PATH=data/processed/cnefe_bahia_normalized.parquet
SEARCH_NORMALIZED_PATH=data/processed/search_addresses_normalized.csv
NORMALIZATION_REPORT_PATH=data/processed/normalization_report.json
BASELINE_OUTPUT_PATH=data/output/baseline_matches.csv
BASELINE_METRICS_PATH=data/output/baseline_metrics.json
# No host: localhost. O Compose sobrescreve para http://elasticsearch:9200.
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX_NAME=cnefe-bahia-addresses-v1
ELASTICSEARCH_BULK_CHUNK_SIZE=2000
ELASTICSEARCH_REQUEST_TIMEOUT_SECONDS=60
ELASTICSEARCH_BULK_MAX_RETRIES=3
ELASTICSEARCH_INDEX_REPORT_PATH=data/output/elasticsearch_index_report.json
ELASTICSEARCH_VALIDATION_REPORT_PATH=data/output/elasticsearch_validation_report.json
CANDIDATE_RETRIEVAL_TOP_K=10
CANDIDATE_RETRIEVAL_MINIMUM_CANDIDATES=5
CANDIDATE_RETRIEVAL_DIAGNOSTICS_PATH=data/output/candidate_retrieval_diagnostics.jsonl
CANDIDATE_RETRIEVAL_CANDIDATES_PATH=data/output/candidate_retrieval_candidates.csv
CANDIDATE_RETRIEVAL_METRICS_PATH=data/output/candidate_retrieval_metrics.json
CANDIDATE_RETRIEVAL_ANALYSIS_PATH=docs/candidate_retrieval_analysis.md
CANDIDATE_SELECTION_STRONG_STREET_SIMILARITY=0.90
CANDIDATE_SELECTION_PLAUSIBLE_STREET_SIMILARITY=0.85
CANDIDATE_SELECTION_AUDIT_PATH=data/output/candidate_selection_audit.csv
CANDIDATE_SELECTION_EVIDENCE_PATH=data/output/candidate_selection_evidence.csv
CANDIDATE_SELECTION_METRICS_PATH=data/output/candidate_selection_metrics.json
MATCHING_STRATEGY_REPORT_PATH=docs/matching_strategy.md
FINAL_RESULT_PATH=data/output/result.csv
FINAL_AUDIT_PATH=data/output/result_audit.csv
FINAL_METRICS_PATH=data/output/result_metrics.json
EVALUATION_CASES_PATH=data/output/evaluation_cases.csv
EVALUATION_LOW_CONFIDENCE_PATH=data/output/low_confidence_cases.csv
EVALUATION_METRICS_PATH=data/output/evaluation_metrics.json
EVALUATION_REPORT_PATH=docs/evaluation.md
EVALUATION_NEAR_THRESHOLD_BAND=0.05
EXPECTED_UF_CODE=29
EXPECTED_SEARCH_RECORDS=107
SPARK_MASTER=local[4]
SPARK_APP_NAME=cnefe-bahia-ingestion
# Consumido pelo servico Elasticsearch no Compose, nao pelo codigo Python.
ES_JAVA_OPTS=-Xms1g -Xmx1g
